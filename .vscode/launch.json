            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
        },
        {
            "name": "Transformer",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/learn_nn/models/transformer/__init__.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
